# Registry configuration lives in ai-stash.lock.json (project-local).
# To add a registry for local development, run:
#   ai-stash registry add <url> --name <name>
# Example:
#   ai-stash registry add http://localhost:3456/registry.json --name local

# GitHub token is resolved automatically via `gh auth token`.
# Only set this if you need to override it explicitly.
# GITHUB_TOKEN=
