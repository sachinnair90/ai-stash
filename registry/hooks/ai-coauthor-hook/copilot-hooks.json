{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node .github/hooks/session-start.mjs",
        "powershell": "node .github/hooks/session-start.mjs",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node .github/hooks/track-ai-edits.mjs",
        "powershell": "node .github/hooks/track-ai-edits.mjs",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node .github/hooks/session-stop.mjs",
        "powershell": "node .github/hooks/session-stop.mjs",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
